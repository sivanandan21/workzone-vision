# WorkZone Vision Environment Configuration

# Runtime Mode: "mock" (offline SQLite state store), "https", or "iot_mqtt"
WORKZONE_TRANSPORT=mock
WORKZONE_CONFIG_PATH=configs/system_config.yaml

# VEXDET RF-DETR ONNX Settings
VEXDET_ONNX_PATH=models/vexdet.onnx
VEXDET_MODEL_NAME=RFDETRNano
VEXDET_CONF_THRESHOLD=0.40
VEXDET_DEDUP_IOU_THRESHOLD=0.50
VEXDET_BLUR_THRESHOLD=100.0
VEXDET_ENABLE_CLAHE=true

# Strict 2-Student Target Mode ("true" = track only enrolled students; "false" = all persons + UNKNOWN_TRACK)
STRICT_TARGET_MODE=true
ALLOW_UNKNOWN_FALLBACK=false

# Camera Sources (RTSP URL, local MP4 path, or webcam index)
CAM_1_SOURCE=rtsp://admin:password@192.168.1.101:554/stream1
CAM_2_SOURCE=rtsp://admin:password@192.168.1.102:554/stream1

# AWS Cloud Integration (when WORKZONE_TRANSPORT=https or iot_mqtt)
AWS_REGION=ap-south-1
AWS_API_ENDPOINT=https://your-api-id.execute-api.ap-south-1.amazonaws.com/prod
AWS_API_KEY=CHANGE_ME_EDGE_INGEST_KEY
AWS_IOT_ENDPOINT=your-ats-endpoint.iot.ap-south-1.amazonaws.com
AWS_IOT_CERT_PATH=edge/certs/device.pem.crt
AWS_IOT_KEY_PATH=edge/certs/private.pem.key
AWS_IOT_CA_PATH=edge/certs/AmazonRootCA1.pem
S3_SNAPSHOT_BUCKET=workzone-crossing-snapshots
AWAY_ALERT_THRESHOLD_SECONDS=900

# Dashboard Auth (Cognito)
VITE_API_BASE_URL=http://localhost:8000
VITE_AUTH_MODE=local_mock
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=ap-south-1
